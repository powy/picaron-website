# EmailJS Configuration
# Get these from https://www.emailjs.com/
# Required for contact form to work
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id_here
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id_here
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key_here

# ---------------------------------------------------------------------------
# Environment & test mode — see shop update plan/12-environnements-et-mode-test.md
# ---------------------------------------------------------------------------
# Four profiles, same code:
#   1. local offline : APP_ENV=local      PAYMENT_PROVIDER=mock   (no internet)
#   2. local Stripe  : APP_ENV=local      PAYMENT_PROVIDER=stripe (sk_test_/pk_test_)
#   3. staging       : APP_ENV=staging    PAYMENT_PROVIDER=stripe (sk_test_/pk_test_)
#   4. production    : APP_ENV=production PAYMENT_PROVIDER=stripe (sk_live_/pk_live_)
# Guards (lib/server/config.ts): mock is refused in production, live keys are
# refused outside production. APP_ENV has no default on purpose.
APP_ENV=local
# Front-end copy of APP_ENV: shows the "test environment" badge (local/staging).
NEXT_PUBLIC_APP_ENV=local

# mock = simulated payment buttons (offline), stripe = real Stripe Elements.
PAYMENT_PROVIDER=mock
# mock = fake relay points (offline), mondialrelay = official widget (needs internet).
NEXT_PUBLIC_RELAY_PICKER=mock

# Order API base URL for the front. Empty = same origin (Next.js /api routes,
# local). Staging/prod: the Scaleway function URL (terraform output api_url).
NEXT_PUBLIC_API_BASE_URL=
# Origins allowed to call the API cross-origin (Scaleway function only).
ALLOWED_ORIGINS=
# Public site URL, used for links in emails.
SITE_URL=http://localhost:3000

# Stripe (profiles 2–4). https://dashboard.stripe.com/test/apikeys
# Locally, STRIPE_WEBHOOK_SECRET is the whsec_... printed by
#   stripe listen --api-key sk_test_... --print-secret
# and forward with:
#   stripe listen --api-key sk_test_... --events payment_intent.succeeded,payment_intent.payment_failed --forward-to localhost:3000/api/stripe-webhook
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Confirmation emails. Locally: Mailpit from infra/local/docker-compose.yml
# (inbox at http://localhost:8025). EMAIL_TRANSPORT=console just prints the
# email in the terminal (offline without Docker; refused in production).
EMAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Picaron <commandes@picaron.fr>

# Mondial Relay Configuration
#
# The ParcelShopPicker widget (mondial-relay-test page, Task 1) only needs the
# Brand Id below. Sandbox/demo brand code "BDTEST" works for testing; replace
# with the real client Brand Id once available from the Mondial Relay contract.
NEXT_PUBLIC_MONDIAL_RELAY_BRAND_CODE=BDTEST
#
# The Web Service API (used later for label creation, Task 11) is a separate
# product with its own three credentials, found on the Mondial Relay Pro
# portal under "Mes paramètres de connexion". These are NOT the same as the
# Brand Id above. Free sandbox values for dev/testing:
# MONDIAL_RELAY_CODE_ENSEIGNE=BDTEST13
# MONDIAL_RELAY_CODE_MARQUE=11
# MONDIAL_RELAY_PRIVATE_KEY=PrivateK
# (older SOAP WSI2/WSI4 uses "PrivateK"; newer REST API V2 uses "TestAPI1key" instead)

# Scaleway Serverless SQL Database
#
# For local development, run `npm run db:local:up` (docker compose, see
# infra/local/) then `npm run db:setup`, and point DATABASE_URL at it — no
# Scaleway account needed:
#   DATABASE_URL=postgres://picaron:picaron@localhost:5433/picaron_commandes
#
# For the real instance: provision it via Terraform (infra/terraform/, see
# its README — requires a Scaleway account), then generate an IAM
# Application + API key scoped to it for the connection string.
# Format: postgres://<user-or-app-id>:<api-secret-key>@<hostname>:5432/<dbname>?sslmode=require
DATABASE_URL=postgres://picaron:picaron@localhost:5433/picaron_commandes
# FIXME(email): TEMPORARY stopgap while no SMTP provider exists. With
# EMAIL_TRANSPORT=emailjs, order emails go to the TEAM (same EmailJS template as
# the contact form, subject tagged "FIXME"), NOT to the customer. Use it in
# staging/production only until SMTP is configured; locally keep smtp (Mailpit).
# EMAIL_TRANSPORT=emailjs
# EMAILJS_SERVICE_ID=
# EMAILJS_TEMPLATE_ID=
# EMAILJS_PUBLIC_KEY=
# Account > Security > private key (server-side calls; may also need
# "Allow EmailJS API for non-browser applications" enabled there).
# EMAILJS_PRIVATE_KEY=

# Every paid or failed order emails the team. Required outside local with
# EMAIL_TRANSPORT=smtp (the server refuses to start without it); with the
# temporary emailjs transport the EmailJS template decides the recipient.
# TEAM_NOTIFY_EMAIL=equipe@exemple.fr

# Shipping methods offered. SHIPPING_METHODS (API) and NEXT_PUBLIC_SHIPPING_METHODS
# (front, baked at build time) must match. Default: mondial_relay,colissimo.
# Use "colissimo" to open the shop without a real Mondial Relay Brand Id.
# SHIPPING_METHODS=colissimo
# NEXT_PUBLIC_SHIPPING_METHODS=colissimo
