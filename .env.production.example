# Variables of the Cloudflare Pages project "picaron-prod" (https://picaron.fr at go-live;
# its *.pages.dev URL until then, used for the real-payment test).
# Public values only: secrets (Stripe live secret key, live webhook secret,
# Orders are served by the Scaleway function only, not by this site.
# Scaleway function serves orders. See shop update plan/13-plan-mise-en-production.md.
# NEXT_PUBLIC_* values are baked at build time: redeploy after any change.
# Never copy values from .env.staging.example: everything below is separate.

# Also enables indexing (app/robots.ts) and hides the test badge.
NEXT_PUBLIC_APP_ENV=production
# terraform output api_url (workspace prod)
NEXT_PUBLIC_API_BASE_URL=https://<prod function url>
NEXT_PUBLIC_RELAY_PICKER=mondialrelay
# No real Mondial Relay Brand Id yet: open Colissimo only. NEVER ship BDTEST to
# customers (it shows sandbox relay points). Must match shipping_methods in prod.tfvars.
# Remove this line (and set the real Brand Id above) to enable Mondial Relay.
NEXT_PUBLIC_SHIPPING_METHODS=colissimo
# Real Mondial Relay Brand Id (not BDTEST)
NEXT_PUBLIC_MONDIAL_RELAY_BRAND_CODE=
# Stripe LIVE publishable key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxx

# Contact form (EmailJS, unrelated to order emails)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
