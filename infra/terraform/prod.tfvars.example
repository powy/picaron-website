# Copy to prod.tfvars (git-ignored). Secrets go in TF_VAR_... env vars.
environment     = "prod"
site_url        = "https://picaron.fr"
# Before go-live, temporarily add the picaron-prod *.vercel.app URL (real-payment
# test) and set site_url to it; restore the two picaron.fr origins at go-live.
allowed_origins = ["https://picaron.fr", "https://www.picaron.fr"]
smtp_host       = "smtp.tem.scaleway.com"

# FIXME(email): TEMPORARY, see staging.tfvars.example. Must be "smtp" before
# real customers order: customers get NO email with "emailjs".
email_transport     = "emailjs"
emailjs_service_id  = "service_xxxxxxx"
emailjs_template_id = "template_xxxxxxx"
emailjs_public_key  = "xxxxxxxxxxxxxxx"

# Every paid or failed order emails the team. Required with "smtp".
# team_notify_email = "equipe@exemple.fr"

# Colissimo only while there is no real Mondial Relay Brand Id (the BDTEST
# sandbox brand must never reach customers). Also set
# NEXT_PUBLIC_SHIPPING_METHODS=colissimo on the picaron-prod Vercel project.
shipping_methods = ["colissimo"]
