# Variables of the Vercel project "picaron-staging" (https://staging.picaron.fr).
# Public values only: secrets (Stripe secret key, webhook secret, DATABASE_URL,
# SMTP) live in Terraform TF_VAR_* on the Scaleway function, never on Vercel.
# Do NOT set APP_ENV here: the Next /api routes must stay inert, only the
# Scaleway function serves orders. See shop update plan/13-plan-mise-en-production.md.
# NEXT_PUBLIC_* values are baked at build time: redeploy after any change.

NEXT_PUBLIC_APP_ENV=staging
# terraform output api_url (workspace staging)
NEXT_PUBLIC_API_BASE_URL=https://<staging function url>
NEXT_PUBLIC_RELAY_PICKER=mondialrelay
# Mondial Relay: the BDTEST sandbox brand is fine on staging. To test Colissimo only:
# NEXT_PUBLIC_SHIPPING_METHODS=colissimo   (must match shipping_methods in staging.tfvars)
NEXT_PUBLIC_MONDIAL_RELAY_BRAND_CODE=BDTEST
# Stripe TEST publishable key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx

# Contact form (EmailJS, unrelated to order emails)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
