{
  "name": "picaron-website",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev",
    "dev:stripe": "node scripts/dev-stripe.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:test": "node --env-file-if-exists=.env.local scripts/db/test-connection.mjs",
    "db:setup": "node --env-file-if-exists=.env.local scripts/db/setup.mjs",
    "db:local:up": "docker compose -f infra/local/docker-compose.yml up -d --wait",
    "db:local:down": "docker compose -f infra/local/docker-compose.yml down",
    "db:local:reset": "docker compose -f infra/local/docker-compose.yml down -v && docker compose -f infra/local/docker-compose.yml up -d --wait && npm run db:setup",
    "test": "node --import tsx --test \"lib/**/*.unit.test.ts\" \"scripts/db/*.unit.test.mjs\"",
    "test:integration": "node --env-file-if-exists=.env.local --import tsx --test --test-concurrency=1 \"lib/**/*.integration.test.ts\" \"scripts/db/*.integration.test.mjs\"",
    "test:e2e": "playwright test",
    "build:functions": "node scripts/build-functions.mjs",
    "tf": "node scripts/terraform.mjs",
    "smoke": "node --env-file-if-exists=.env.local scripts/smoke-test.mjs",
    "ci": "node scripts/ci-local.mjs"
  },
  "dependencies": {
    "@emailjs/browser": "^5.0.3",
    "@stripe/react-stripe-js": "^7.0.1",
    "@stripe/stripe-js": "^10.2.0",
    "framer-motion": "^14.6.0",
    "next": "^16.0.7",
    "next-intl": "^4.5.8",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stripe": "^23.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.11.32",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
